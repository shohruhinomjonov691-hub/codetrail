# Copy to .env (never commit .env). Values here are names/placeholders only.

# Where mirrors, registry and snapshot artifacts are written. Default: ./data
CODETRAIL_DATA_DIR=

# Colon-separated absolute directories that local sources must live under.
# A local source outside these roots (after resolving symlinks) is rejected.
CODETRAIL_LOCAL_ROOTS=

# Local embeddings. Weights live outside the repo.
# Directory with runtime/ and models/ (see scripts/fetch-models.mjs). Default: ./models (git-ignored)
CODETRAIL_MODELS_DIR=
# Local llama-server for embeddings (loopback by default).
CODETRAIL_EMBED_URL=http://127.0.0.1:8081
# Extra internal provider host names allowed besides loopback (e.g. a Docker service name).
CODETRAIL_PROVIDER_HOSTS=

# Projects the HTTP server offers (operator-managed): "project" or "project:snapshot", comma-separated.
# Empty = every registered project with a usable index.
CODETRAIL_SERVE_PROJECTS=
# Set to 1 only behind a trusted reverse proxy (uses X-Forwarded-For as the client id for rate limits).
CODETRAIL_TRUST_PROXY=

# AI explanation via the OpenAI API (backend only; never exposed to the browser).
# Without a key, search still works and the UI shows code sources instead of an explanation.
CODETRAIL_OPENAI_API_KEY=
CODETRAIL_OPENAI_MODEL=gpt-6-luna
# none | low | medium | high — use none for models without reasoning support
CODETRAIL_OPENAI_REASONING=low
# Limits (defaults shown)
CODETRAIL_AI_MAX_OUTPUT_TOKENS=2048
CODETRAIL_AI_MAX_CONTEXT_CHARS=12000
CODETRAIL_AI_TIMEOUT_MS=30000
CODETRAIL_AI_CONCURRENCY=2
CODETRAIL_AI_RATE_PER_MINUTE=6
CODETRAIL_AI_DAILY_LIMIT=200
CODETRAIL_AI_CACHE_SIZE=500
