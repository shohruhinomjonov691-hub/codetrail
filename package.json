{
  "name": "codetrail",
  "version": "0.1.0",
  "private": true,
  "description": "Codebase RAG for TypeScript/JavaScript repositories: exact-commit snapshots, local hybrid search and grounded AI explanations with server-checked citations.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codetrail": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "node --env-file-if-exists=.env dist/cli.js"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "4.1.11"
  }
}
